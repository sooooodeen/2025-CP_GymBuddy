import numpy as np
import os

# --- Model Parameters (Must Match your LSTM) ---
SEQUENCE_LENGTH = 90  # The sequence length your LSTM was trained on
FEATURE_SIZE = 8      # The 8 angles extracted per frame
NUM_SEQUENCES = 200   # The number of sequences needed for TFLite calibration

# --- File Location ---
TRAINING_ARTIFACTS_DIR = 'training'
CALIBRATION_DATA_FILENAME = os.path.join(TRAINING_ARTIFACTS_DIR, 'calibration_features.npy')

# Ensure the directory exists
os.makedirs(TRAINING_ARTIFACTS_DIR, exist_ok=True)

# 1. Generate the dummy data
dummy_calibration_data = np.random.uniform(
    low=0.0, 
    high=180.0, 
    size=(NUM_SEQUENCES, SEQUENCE_LENGTH, FEATURE_SIZE)
).astype(np.float32)

# 2. Save the file without allowing pickling (Default behavior, but ensures format integrity)
try:
    # Use np.save() without extra flags to ensure the standard array format is used
    np.save(CALIBRATION_DATA_FILENAME, dummy_calibration_data)
    
    print("✅ Successfully regenerated the calibration file for TFLite.")
    print(f"File saved at: {os.path.abspath(CALIBRATION_DATA_FILENAME)}")
    print("\n--- Next: Re-run the convert_model.py script ---")

except Exception as e:
    print(f"❌ ERROR saving calibration file: {e}")